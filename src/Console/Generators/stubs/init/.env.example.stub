APP_NAME="{{APP_NAME}}"
APP_ENV=local
APP_DEBUG=true
APP_URL={{APP_URL}}
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_KEY=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE={{DB_NAME}}
DB_USERNAME=root
DB_PASSWORD=
DB_PREFIX=

# First administrator, created by "vendor/bin/racin db:seed" (leave the password empty to skip)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

CORS_ALLOWED_ORIGINS=*
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
BROADCAST_DRIVER=null
JWT_TTL=3600
