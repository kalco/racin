{
    "name": "rokastudio/racin",
    "description": "A small, fast PHP 8.3+ framework for JSON APIs: Rails-style controllers and generators, ActiveRecord-style models, serializers, JWT auth, queues, mail, image uploads and WebSockets.",
    "type": "library",
    "keywords": [
        "framework",
        "api",
        "json",
        "rest",
        "jwt",
        "orm",
        "active-record",
        "rails",
        "generators"
    ],
    "homepage": "https://github.com/kalco/racin",
    "license": "MIT",
    "authors": [
        {
            "name": "Roka Studio",
            "homepage": "https://github.com/kalco"
        }
    ],
    "support": {
        "issues": "https://github.com/kalco/racin/issues",
        "source": "https://github.com/kalco/racin"
    },
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "psr/container": "^2.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "suggest": {
        "ext-pdo_mysql": "MySQL / MariaDB connections.",
        "ext-pdo_pgsql": "PostgreSQL connections.",
        "ext-pdo_sqlite": "SQLite connections and the test suite.",
        "ext-gd": "Image uploads (resize, WebP thumbnails).",
        "ext-exif": "Honour the EXIF orientation of uploaded photos.",
        "ext-fileinfo": "Detect the real type of uploaded files.",
        "ext-intl": "Transliterate non-Latin text in Str::slug().",
        "ext-redis": "Redis cache and queue drivers."
    },
    "autoload": {
        "psr-4": {
            "Racin\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Racin\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/racin"
    ],
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
